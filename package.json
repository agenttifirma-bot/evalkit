{
  "name": "@tonyweckstrom/evalkit",
  "version": "0.3.0",
  "description": "Aja sama prompt-sarja usealla mallilla ja estä regressiot CI:ssä: CLI, joka vertaa tuloksia edelliseen hyväksyttyyn ajoon. Eval runner with a regression gate for CI.",
  "license": "MIT",
  "author": "Tony Weckström",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyweckstrom1987/evalkit.git"
  },
  "homepage": "https://github.com/tonyweckstrom1987/evalkit#readme",
  "bugs": {
    "url": "https://github.com/tonyweckstrom1987/evalkit/issues"
  },
  "keywords": [
    "llm",
    "eval",
    "evals",
    "regression",
    "ci",
    "baseline",
    "litellm",
    "openrouter",
    "openai-compatible",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "evalkit": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tonyweckstrom/llm-cassette": "^0.2.0",
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@tonyweckstrom/llm-cassette": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@tonyweckstrom/llm-cassette": {
      "optional": true
    }
  }
}
